{
  "name": "@whaly/connector-sdk",
  "version": "0.3.7",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist/**",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --sourcemap --clean",
    "prepack": "npm run build",
    "clean": "rimraf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/whalyapp/connector-sdk.git"
  },
  "author": "Whaly",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/whalyapp/connector-sdk/issues"
  },
  "homepage": "https://github.com/whalyapp/connector-sdk#readme",
  "description": "",
  "dependencies": {
    "@google-cloud/bigquery": "^8.1.1",
    "@google-cloud/storage": "^7.17.2",
    "ajv": "^8.18.0",
    "ajv-formats": "^3.0.1",
    "async-mutex": "^0.5.0",
    "async-retry": "^1.3.3",
    "axios": "^1.13.0",
    "axios-retry": "^4.5.0",
    "bluebird": "^3.7.2",
    "csv-parser": "^3.2.0",
    "csv-writer": "^1.6.0",
    "dayjs": "^1.11.13",
    "decimal.js": "^10.6.0",
    "decompress": "^4.2.1",
    "dependency-graph": "^1.0.0",
    "dotenv": "^17.3.1",
    "fs-extra": "^11.3.2",
    "iconv-lite": "^0.6.3",
    "jsonschema": "^1.5.0",
    "lodash": "^4.17.21",
    "qs": "^6.13.0",
    "sharp": "^0.34.5",
    "ssh2-sftp-client": "^12.0.0",
    "winston": "^3.18.3",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@types/async-retry": "^1.4.9",
    "@types/bluebird": "^3.5.42",
    "@types/decompress": "^4.2.7",
    "@types/fs-extra": "^11.0.4",
    "@types/lodash": "^4.17.20",
    "@types/node": "^24.9.1",
    "@types/qs": "^6.14.0",
    "@types/sharp": "^0.31.1",
    "@types/ssh2-sftp-client": "^9.0.4",
    "rimraf": "^5.0.10",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
